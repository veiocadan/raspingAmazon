# Rasping Amazon — environment contract (FASE 21-B2)
#
# This file contains examples only. Never commit actual credentials or tokens.
# The Java runtime reads process environment variables (System.getenv).
# Copying this file to .env alone does NOT inject its values into the Java
# process: load/export variables in your shell or service before startup.
# Docker Compose separately reads .env for ${DB_PASSWORD} interpolation.
#
# Defaults marked "runtime default" correspond to existing Java providers.
# Values marked CHANGE_ME must be configured before using the related
# integration; they are not real credentials.
#
# Scope: existing application configuration; PostgreSQL role separation,
# least-privilege credentials and secure Compose exposure belong to FASE 21-C.

# ============================================================
# APPLICATION AND POSTGRESQL
# ============================================================

APP_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rasping_amazon
# Transitional development role used by the existing Compose configuration.
# FASE 21-C2-E-D-B introduces optional migration-only credentials.
# Keep DB_USER/DB_PASSWORD unchanged until separate logins exist.
DB_USER=rasping
DB_PASSWORD=CHANGE_ME

# Optional pair for Flyway only. Configure BOTH together, never just one.
# Leave commented during C2-E-D-B: the PostgreSQL roles are still NOLOGIN.
# Once credentials and logins are provisioned in a later stage, Flyway
# will use these values while JDBC continues using DB_USER/DB_PASSWORD.
# DB_MIGRATION_USER=rasping_migrator
# DB_MIGRATION_PASSWORD=CHANGE_ME

# Required for generation of Amazon affiliate links.
AMAZON_ASSOCIATE_TAG=CHANGE_ME

# ============================================================
# CONTINUOUS PROCESSING AND SOURCE
# ============================================================

# Optional stable schedule identity; runtime default: amazon-deals.
PROCESSING_SCHEDULE_KEY=amazon-deals

# Current HTML source; runtime default is this exact URI.
PROCESSING_SOURCE_URI=https://www.amazon.com.br/deals

# REQUIRED: no compiled/default collection schedule interval exists.
# PT1H is an explicit example, NOT an automatic runtime default.
# This interval is used on the schedule's INITIAL creation. Subsequent
# scheduling state is owned by PostgreSQL, not silently overwritten here.
PROCESSING_SCHEDULE_INTERVAL=PT1H

# Optional worker/scheduler identities: when absent, generated with a unique
# runtime instance identifier. Keep these commented for ordinary execution.
# PROCESSING_SCHEDULER_INSTANCE_ID=CHANGE_ME_UNIQUE_SCHEDULER_ID
# PROCESSING_WORKER_ID=CHANGE_ME_UNIQUE_WORKER_ID

# Technical runtime defaults already defined by the current providers.
PROCESSING_SCHEDULER_POLL_INTERVAL=PT2S
PROCESSING_SCHEDULER_LEASE_DURATION=PT1M
PROCESSING_WORKER_IDLE_DELAY=PT0.25S
PROCESSING_COLLECTION_MAX_ATTEMPTS=3
PROCESSING_ENRICHMENT_MAX_ATTEMPTS=3
PROCESSING_EVALUATION_MAX_ATTEMPTS=3
PROCESSING_RETRY_BASE_DELAY=PT30S
PROCESSING_RETRY_MAX_DELAY=PT5M

# ============================================================
# STARTUP RECOVERY — FASE 20
# ============================================================

# These are technical defaults already defined by the runtime.
# Batch size and reconciliation limit denote page size, not total cap.
PROCESSING_JOB_RECOVERY_LEASE_DURATION=PT15M
PROCESSING_JOB_RECOVERY_BATCH_SIZE=100
PUBLICATION_OUTBOX_RECOVERY_LEASE_DURATION=PT5M
PUBLICATION_DISPATCH_MAX_ATTEMPTS=3
PUBLICATION_DISPATCH_RECONCILIATION_LIMIT=100

# ============================================================
# EXTERNAL PUBLICATION CHANNELS
# ============================================================

# Channels are disabled unless explicitly enabled. Do not enable with
# placeholder credentials/destinations or before provider onboarding.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_API_BASE_URI=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT=PT10S
TELEGRAM_DESTINATION=CHANGE_ME

# Telegram link-preview presentation (existing runtime defaults).
TELEGRAM_LINK_PREVIEW_ENABLED=true
TELEGRAM_LINK_PREVIEW_POSITION=ABOVE
TELEGRAM_LINK_PREVIEW_SIZE=LARGE

# Manual WhatsApp staging sends WhatsApp-formatted text to private Telegram.
# A successful staging delivery does not mean a WhatsApp message was posted.
WHATSAPP_MANUAL_ENABLED=false
WHATSAPP_MANUAL_TELEGRAM_DESTINATION=CHANGE_ME

# Official Meta WhatsApp Cloud API only (not OpenWA; see ADR-0017).
# Graph API version MUST follow vN.N when this provider is loaded.
# Template name/language must match an approved provider template.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_GRAPH_API_VERSION=CHANGE_ME
WHATSAPP_GRAPH_API_BASE_URI=https://graph.facebook.com
WHATSAPP_TEMPLATE_NAME=amazon_offer
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_REQUEST_TIMEOUT=PT10S

# ============================================================
# PUBLICATION OUTBOX RETRY
# ============================================================

# Existing runtime defaults. DELIVERY_UNKNOWN must not be blindly retried.
PUBLICATION_OUTBOX_MAX_ATTEMPTS=5
PUBLICATION_OUTBOX_RETRY_INITIAL_BACKOFF=PT30S
PUBLICATION_OUTBOX_RETRY_MAX_BACKOFF=PT5M

# ============================================================
# PERSISTENT PUBLICATION RATE LIMIT
# ============================================================

# These are conservative LOCAL throttling values, not official API quotas.
# TELEGRAM and WHATSAPP_MANUAL share the TELEGRAM_BOT_API integration.
PUBLICATION_RATE_LIMIT_TELEGRAM_BOT_API_MIN_INTERVAL=PT1S
PUBLICATION_RATE_LIMIT_WHATSAPP_CLOUD_API_MIN_INTERVAL=PT1S

# ============================================================
# PRIMARY PUBLICATION SCOPE, SELECTION, QUOTA AND CADENCE
# ============================================================

# Business/operational parameters must be explicitly configured.
# These are candidate examples, not compiled defaults. Changes to a
# persisted immutable profile should use a NEW configuration version.
PUBLICATION_PRIMARY_CHANNEL=TELEGRAM
PUBLICATION_PRIMARY_DESTINATION=CHANGE_ME

PUBLICATION_SELECTION_VERSION=PUBLICATION_SELECTION_V1_CONFIG_V1
PUBLICATION_SELECTION_HARD_COOLDOWN=PT48H
PUBLICATION_SELECTION_PREFERRED_COOLDOWN=PT168H

PUBLICATION_QUOTA_VERSION=QUOTA_V1
PUBLICATION_QUOTA_MAX_PER_DAY=7
PUBLICATION_QUOTA_ZONE=America/Sao_Paulo

PUBLICATION_CADENCE_VERSION=CADENCE_V1
PUBLICATION_CADENCE_INTERVAL=PT2H
PUBLICATION_CADENCE_WINDOW_START=08:00
PUBLICATION_CADENCE_WINDOW_END=22:00
PUBLICATION_CADENCE_ZONE=America/Sao_Paulo

# ============================================================
# OPERATIONAL ALERT POLICY — CONFIGURE WHEN USING ALERTS CLI
# ============================================================

# The alert provider deliberately has NO numeric defaults. Each variable
# below is mandatory when alert policy loading is explicitly requested.
# Configure all five with operationally justified numeric thresholds.
# Do not activate these CHANGE_ME placeholders as numeric values.
# ALERT_REPEATED_EXTERNAL_FAILURE_THRESHOLD=CHANGE_ME
# ALERT_REPEATED_EXTERNAL_FAILURE_WINDOW_SECONDS=CHANGE_ME
# ALERT_SUSPICIOUS_COLLECTION_LOOKBACK_RUNS=CHANGE_ME
# ALERT_SUSPICIOUS_COLLECTION_DROP_FRACTION=CHANGE_ME
# ALERT_SUSPICIOUS_COLLECTION_MINIMUM_BASELINE_CANDIDATES=CHANGE_ME

# Normalização padrão.
* text=auto eol=lf

# Código e configuração.
*.java text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Scripts Unix.
*.sh text eol=lf
mvnw text eol=lf

# Scripts Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
mvnw.cmd text eol=crlf

# Binários.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
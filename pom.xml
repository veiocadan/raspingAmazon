<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.raspingamazon</groupId>
    <artifactId>rasping-amazon</artifactId>
    <version>1.0-SNAPSHOT</version>

    <name>rasping-amazon</name>

    <description>
        Automação de ofertas Amazon para publicação em grupos de promoções
    </description>

    <properties>

        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>

        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

        <project.reporting.outputEncoding>
            UTF-8
        </project.reporting.outputEncoding>

        <junit.version>5.12.2</junit.version>
        <jackson.version>2.20.0</jackson.version>
        <jsoup.version>1.18.3</jsoup.version>

        <playwright.version>1.63.0</playwright.version>

        <maven.compiler.plugin.version>
            3.15.0
        </maven.compiler.plugin.version>

        <maven.surefire.plugin.version>
            3.5.4
        </maven.surefire.plugin.version>

        <maven.jar.plugin.version>
            3.5.0
        </maven.jar.plugin.version>

        <exec.maven.plugin.version>
            3.6.4
        </exec.maven.plugin.version>

        <build.helper.maven.plugin.version>
            3.6.2
        </build.helper.maven.plugin.version>

    </properties>

    <dependencies>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>11.14.1</version>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>11.14.1</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.8</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!--
            Parsing estrutural do HTML Amazon.

            O objetivo é localizar elementos reais por id e interpretar
            tabelas/atributos sem depender de offsets arbitrários do HTML.
        -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>

    </dependencies>

    <build>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>

                <configuration>
                    <release>
                        ${maven.compiler.release}
                    </release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.plugin.version}</version>
            </plugin>

            <!--
                Execução local da interface operacional.

                O plugin não é associado automaticamente a nenhuma fase
                do lifecycle Maven. A CLI é executada somente quando
                exec:java é solicitado explicitamente.

                blockSystemExit protege a JVM do Maven caso o entrypoint
                precise produzir um código de saída diferente de zero.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.maven.plugin.version}</version>

                <configuration>

                    <mainClass>
                        com.raspingamazon.infrastructure.bootstrap.OperationalCliMain
                    </mainClass>

                    <classpathScope>
                        runtime
                    </classpathScope>

                    <blockSystemExit>
                        true
                    </blockSystemExit>

                </configuration>
            </plugin>

        </plugins>

    </build>

    <profiles>

        <profile>

            <id>external-probe</id>

            <dependencies>

                <dependency>
                    <groupId>com.microsoft.playwright</groupId>
                    <artifactId>playwright</artifactId>
                    <version>${playwright.version}</version>
                    <scope>test</scope>
                </dependency>

            </dependencies>

            <build>

                <plugins>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>
                            ${build.helper.maven.plugin.version}
                        </version>

                        <executions>

                            <execution>

                                <id>
                                    add-external-probe-test-source
                                </id>

                                <phase>
                                    generate-test-sources
                                </phase>

                                <goals>
                                    <goal>
                                        add-test-source
                                    </goal>
                                </goals>

                                <configuration>

                                    <sources>

                                        <source>
                                            src/external-probe/java
                                        </source>

                                    </sources>

                                </configuration>

                            </execution>

                        </executions>

                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${maven.surefire.plugin.version}</version>

                        <configuration>

                            <includes>

                                <include>
                                    **/*ExternalProbeIT.java
                                </include>

                            </includes>

                        </configuration>

                    </plugin>

                </plugins>

            </build>

        </profile>

    </profiles>

</project>
